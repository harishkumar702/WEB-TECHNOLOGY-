<!DOCTYPE html>
<html>
<head>
<title>Absolute Positioning</title>
<style>
.container {
    position: relative;
    width: 300px;
    height: 200px;
    border: 2px solid black;
}
.box1 {
    position: absolute;
    top: 30px;
    left: 40px;
    width: 120px;
    height: 80px;
    background-color: lightblue;
}
.box2 {
    position: absolute;
    top: 60px;
    left: 70px;
    width: 120px;
    height: 80px;
    background-color: lightcoral;
}
</style>
</head>
<body>

<div class="container">
  <div class="box1">Box 1</div>
  <div class="box2">Box 2</div>
</div>

</body>
</html>
