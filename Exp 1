<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Header Tags Example</title>
</head>
<body>

<header>
    <h1>My Website</h1>
    <nav>
        <a href="#">Home</a> |
        <a href="#">About</a> |
        <a href="#">Contact</a>
    </nav>
    <p>Welcome to my webpage</p>
</header>

<section>
    <h2>Main Content</h2>
    <p>This is the body part of the webpage.</p>
</section>

<footer>
    <p>&copy; 2026 My Website</p>
</footer>

</body>
</html>
