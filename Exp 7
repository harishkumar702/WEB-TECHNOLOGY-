<!DOCTYPE html>
<html>
<head>
    <title>Float Positioning</title>
    <style>
        .box1 {
            width: 150px;
            height: 100px;
            background-color: lightblue;
            float: left;
        }
        .box2 {
            width: 150px;
            height: 100px;
            background-color: lightcoral;
            float: left;
            margin-left: -50px;
        }
    </style>
</head>
<body>

<div class="box1">Box 1</div>
<div class="box2">Box 2</div>

</body>
</html>
